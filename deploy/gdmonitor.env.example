# Helye: ~/.config/gdmonitor/gdmonitor.env
# FIGYELEM: ez systemd EnvironmentFile, nem shell szkript. Az = jel köré
# nem kerülhet szóköz, és az idézőjelek a beolvasott érték részévé válnak.

FEED_URL=https://magyarkozlony.hu/feed

# Konténeren belüli abszolút útvonalak; a /data a hosztról csatolt kötet.
DB_PATH=/data/gazettes.db
DOWNLOAD_PATH=/data/downloads

# Statikus alsó korlát, NEM állapot: a program soha nem írja felül.
# Az inkrementális működést az adatbázis URL-alapú deduplikációja adja.
SINCE_DATE=2025-07-30

# Network=host mellett a hoszt localhostján figyelő relay.
MSG_SERVER=127.0.0.1
MSG_PORT=8025

# Email címek vesszővel elválasztva.
EMAIL_TO=
EMAIL_CC=
EMAIL_BCC=

LOG_LEVEL=INFO
