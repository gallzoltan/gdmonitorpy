# Fejlesztői konfiguráció. Másold .env néven a projekt gyökerébe.
# Az éles, konténeres beállítás a deploy/gdmonitor.env.example alapján készül.
FEED_URL=https://magyarkozlony.hu/feed
DB_PATH=database/gazettes.db
DOWNLOAD_PATH=downloads
# CA köteg csak TLS-t bontó proxy mögött kell; alapból a certifi gyökerei
# CERTIFICATE_PATH=certificates/ca-bundle.pem

# Statikus alsó korlát, nem állapot: a program soha nem írja felül.
SINCE_DATE=2025-07-30

MSG_SERVER=127.0.0.1
MSG_PORT=8025

# Email címek vesszővel elválasztva
EMAIL_TO=
EMAIL_CC=
EMAIL_BCC=

LOG_LEVEL=INFO
